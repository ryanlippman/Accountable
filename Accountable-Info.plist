<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ryanlippman.accountable</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>accountable</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSMicrophoneUsageDescription</key>
	<string>Accountable listens while you hold the brain dump button, so you can say everything on your mind and turn it into tasks.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Your brain dump is turned into text so it can be split into tasks. When your iPhone supports it, this happens entirely on the device.</string>
	<key>NSCameraUsageDescription</key>
	<string>Scan an assignment sheet, syllabus or whiteboard and turn it into tasks.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBG</string>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
